datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  renter
  owner
  shop
  agent
  admin
}

enum UserStatus {
  active
  limited
  banned
}

enum Language {
  en
  hi
}

enum BookingState {
  requested
  approved
  picked_up
  returned
  closed
  cancelled
}

model User {
  id         String     @id @default(uuid())
  phone      String     @unique
  role       UserRole   @default(renter)
  status     UserStatus
  language   Language
  trustScore Int        @default(0)

  bookings         Booking[]
  lastTrustEventAt DateTime?

  wallet          Wallet?
  trustEvents     TrustEvent[]
  ruleAcceptances RuleAcceptance[]
  fitAcceptances  FitAcceptance[]

  heightCm      Int?
  weightKg      Int?
  chestCm       Int?
  waistCm       Int?
  fitPreference String?

  onboardingApplications OnboardingApplication[]
  demandRequests         DemandRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  availableBalance Int      @default(0)
  escrowBalance    Int      @default(0)
  currency         String   @default("INR")
  createdAt        DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id])
  ledger LedgerEntry[]
}

model LedgerEntry {
  id          String  @id @default(uuid())
  walletId    String
  amount      Int
  type        String
  reason      String
  referenceId String?

  wallet Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
}

model Escrow {
  id        String @id @default(uuid())
  bookingId String @unique

  renterId String
  ownerId  String

  rentalFee Int
  deposit   Int

  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrustEvent {
  id          String  @id @default(uuid())
  userId      String
  type        String
  delta       Int
  reason      String
  referenceId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model RuleVersion {
  id       String   @id @default(uuid())
  version  Int
  language Language
  content  String
  isActive Boolean  @default(false)

  createdAt DateTime @default(now())

  acceptances RuleAcceptance[]

  @@unique([version, language])
}

model RuleAcceptance {
  id         String   @id @default(uuid())
  userId     String
  ruleId     String
  acceptedAt DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id])
  RuleVersion   RuleVersion? @relation(fields: [ruleVersionId], references: [id])
  ruleVersionId String?

  @@unique([userId, ruleId])
}

model Booking {
  id     String @id @default(uuid())
  userId String
  itemId String

  rentalFee Int
  deposit   Int

  state String

  returnVerifiedAt DateTime?
  damageType       String?
  damagePenalty    Int?

  startDate DateTime
  endDate   DateTime

  ownerPayoutAt     DateTime?
  depositReleasedAt DateTime?
  closedAt          DateTime?

  pickupVerifiedAt DateTime?
  issueWindowUntil DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])
}

model FitAcceptance {
  id         String   @id @default(uuid())
  userId     String
  itemId     String
  acceptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
}

model Item {
  id      String @id @default(uuid())
  ownerId String

  category  String
  gender    String
  size      String
  fabric    String
  wearLevel String

  state String
  zone  String

  garmentChestCm  Int?
  garmentWaistCm  Int?
  garmentLengthCm Int?

  stretchability String?
  fitType        String?

  cooldownUntil  DateTime?
  lastReturnedAt DateTime?
  isVisible      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id])

  conditionSnapshots ConditionSnapshot[]
  fitAcceptances     FitAcceptance[]
  demandSuggestions  DemandSuggestion[]
  bookings           Booking[]
}

model ConditionSnapshot {
  id        String  @id @default(uuid())
  itemId    String
  bookingId String?

  type String

  photoHash String
  checklist String

  capturedBy   String
  capturedById String?

  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@unique([itemId, type])
  @@index([itemId])
  @@index([bookingId])
}

model OnboardingApplication {
  id           String    @id @default(uuid())
  userId       String
  type         String
  businessName String?
  description  String
  status       String
  reviewedBy   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DemandRequest {
  id        String   @id @default(uuid())
  userId    String
  zone      String
  category  String
  gender    String
  size      String
  eventDate DateTime

  status    String
  expiresAt DateTime

  feePaid Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  suggestions DemandSuggestion[]
}

model DemandSuggestion {
  id       String @id @default(uuid())
  demandId String
  itemId   String

  createdAt DateTime @default(now())

  demand DemandRequest @relation(fields: [demandId], references: [id])
  item   Item          @relation(fields: [itemId], references: [id])

  @@unique([demandId, itemId])
}

model AdminActionLog {
  id       String  @id @default(uuid())
  adminId  String
  action   String
  targetId String
  metadata String?

  createdAt DateTime @default(now())
}
