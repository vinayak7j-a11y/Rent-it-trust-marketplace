datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ENUMS

enum UserRole {
  renter
  owner
  shop
  agent
  admin
}

enum UserStatus {
  active
  limited
  banned
}

enum Language {
  en
  hi
}

// MODELS

model User {
  id         String     @id @default(uuid())
  phone      String     @unique
  role       UserRole
  status     UserStatus
  language   Language
  trustScore Int        @default(0)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}
