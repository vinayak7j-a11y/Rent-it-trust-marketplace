datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  renter
  owner
  shop
  agent
  admin
}

enum UserStatus {
  active
  limited
  banned
}

enum Language {
  en
  hi
}

model User {
  id               String               @id @default(uuid())
  phone            String               @unique
  role             UserRole
  status           UserStatus
  language         Language
  trustScore       Int                  @default(0)
  lastTrustEventAt DateTime?
  // relations
  wallet           Wallet?
  trustEvents      TrustEvent[]
  ruleAcceptances  UserRuleAcceptance[]
  fitAcceptances   FitAcceptance[]
  heightCm         Int?
  weightKg         Int?
  chestCm          Int?
  waistCm          Int?
  fitPreference    String? // slim | regular | loose 

  onboardingApplications OnboardingApplication[]
  demandRequests         DemandRequest[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  Item Item[]
}

model Wallet {
  id       String @id @default(uuid())
  userId   String @unique 
  balance  Int    @default(0)
  currency String @default("INR") 
  user   User          @relation(fields: [userId], references: [id]) 
  createdAt DateTime @default(now()) 
  
  ledger LedgerEntry[]
}

model LedgerEntry {
  id          String  @id @default(uuid())
  walletId    String
  amount      Int
  type        String
  reason      String
  referenceId String?

  wallet Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
}

model Escrow {
  id        String @id @default(uuid())
  bookingId String @unique

  renterId String
  ownerId  String

  rentalFee Int
  deposit   Int

  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrustEvent {
  id          String  @id @default(uuid())
  userId      String
  type        String
  delta       Int
  reason      String
  referenceId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model RuleVersion {
  id       String   @id @default(uuid())
  version  Int
  language Language
  content  String
  isActive Boolean  @default(false)

  createdAt DateTime @default(now())

  acceptances UserRuleAcceptance[]

  @@unique([version, language])
}

model UserRuleAcceptance {
  id            String @id @default(uuid())
  userId        String
  ruleVersionId String

  acceptedAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id])

  @@unique([userId, ruleVersionId])
}

model FitAcceptance {
  id         String   @id @default(uuid())
  userId     String
  bookingId  String
  acceptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, bookingId])
}

model Item {
  id      String @id @default(uuid())
  ownerId String

  category  String
  gender    String
  size      String
  fabric    String
  wearLevel String

  state String
  zone  String

  garmentChestCm     Int?
  garmentWaistCm     Int?
  garmentLengthCm    Int?
  stretchability     String? // none | low | medium | high
  fitType            String? // slim | regular | loose
  conditionSnapshots ConditionSnapshot[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  cooldownUntil  DateTime?
  lastReturnedAt DateTime?
  isVisible      Boolean   @default(false)
  owner          User      @relation(fields: [ownerId], references: [id])
}

model ConditionSnapshot {
  id        String @id @default(uuid())
  itemId    String
  bookingId String

  photoHash  String
  checklist  String // JSON string
  capturedBy String // shop | agent | admin

  createdAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@unique([itemId, bookingId])
}

model OnboardingApplication {
  id           String    @id @default(uuid())
  userId       String
  type         String // owner | shop
  businessName String?
  description  String
  status       String // pending | approved | rejected
  reviewedBy   String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DemandRequest {
  id        String   @id @default(uuid())
  userId    String
  zone      String
  category  String
  gender    String
  size      String
  eventDate DateTime

  status    String // active | fulfilled | expired
  expiresAt DateTime

  feePaid Int // paise

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
