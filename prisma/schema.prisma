datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  renter
  owner
  shop
  agent
  admin
}

enum UserStatus {
  active
  limited
  banned
}

enum Language {
  en
  hi
}

model User {
  id               String               @id @default(uuid())
  phone            String               @unique
  role             UserRole
  status           UserStatus
  language         Language
  trustScore       Int                  @default(0)
  lastTrustEventAt DateTime?
  // relations
  wallet           Wallet?
  trustEvents      TrustEvent[]
  ruleAcceptances  UserRuleAcceptance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Item Item[]
}

model Wallet {
  id       String @id @default(uuid())
  userId   String @unique
  currency String @default("INR")

  user   User          @relation(fields: [userId], references: [id])
  ledger LedgerEntry[]

  createdAt DateTime @default(now())
}

model LedgerEntry {
  id          String  @id @default(uuid())
  walletId    String
  amount      Int
  type        String
  reason      String
  referenceId String?

  wallet Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
}

model Escrow {
  id        String @id @default(uuid())
  bookingId String @unique

  renterId String
  ownerId  String

  rentalFee Int
  deposit   Int

  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrustEvent {
  id          String  @id @default(uuid())
  userId      String
  type        String
  delta       Int
  reason      String
  referenceId String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model RuleVersion {
  id       String   @id @default(uuid())
  version  Int
  language Language
  content  String
  isActive Boolean  @default(false)

  createdAt DateTime @default(now())

  acceptances UserRuleAcceptance[]

  @@unique([version, language])
}

model UserRuleAcceptance {
  id            String @id @default(uuid())
  userId        String
  ruleVersionId String

  acceptedAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  ruleVersion RuleVersion @relation(fields: [ruleVersionId], references: [id])

  @@unique([userId, ruleVersionId])
}

model Item {
  id      String @id @default(uuid())
  ownerId String

  category  String
  gender    String
  size      String
  fabric    String
  wearLevel String

  state String
  zone  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cooldownUntil  DateTime?
  lastReturnedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id])
}
