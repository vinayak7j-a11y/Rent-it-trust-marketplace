generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}


datasource db {
  provider = "postgresql"
}


enum UserRole {
  renter
  owner
  shop
  agent
  admin
}

enum UserStatus {
  active
  limited
  banned
}

enum Language {
  en
  hi
}
model User {
  id         String     @id @default(uuid())
  phone      String     @unique
  role       UserRole
  status     UserStatus
  language   Language
  trustScore Int        @default(0)

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  ruleAcceptances UserRuleAcceptance[]   // ➕ REQUIRED
}


model RuleVersion {
  id          String    @id @default(uuid())
  version     Int
  language    Language
  contentHash String
  createdAt   DateTime  @default(now())

  userAcceptances UserRuleAcceptance[]   // ➕ REQUIRED

  @@unique([version, language])
}

model UserRuleAcceptance {
  id            String   @id @default(uuid())
  userId        String
  ruleVersionId String
  acceptedAt    DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id])
  ruleVersion   RuleVersion  @relation(fields: [ruleVersionId], references: [id])

  @@unique([userId, ruleVersionId])
}
